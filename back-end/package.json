{
  "name": "dormshare-back-end",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:check": "node check-db.js",
    "test": "mocha \"test/**/*.test.js\"",
    "test:coverage": "c8 --all --include app.js --include \"routes/**\" --reporter=text mocha \"test/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3"
  }
}
