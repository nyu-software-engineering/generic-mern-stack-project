    "test:coverage": "c8 npm test",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.2"
  }
}
